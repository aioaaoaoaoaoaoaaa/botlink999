# ===== Site 1 (BẮT BUỘC) =====
# Không còn giá trị mặc định trong code -> phải cấu hình ở đây hoặc env của PaaS
SCRAPER_URL=https://link999.app/auth/signin
SCRAPER_USERNAME=your_username_site1
SCRAPER_PASSWORD=your_password_site1

# ===== Site 2 (TÙY CHỌN - bỏ trống cả 2 để skip site 2) =====
SCRAPER_URL2=https://link999.win/auth/signin
SCRAPER_USERNAME2=your_username_site2
SCRAPER_PASSWORD2=your_password_site2

# ===== Hành vi scraper =====
SCRAPER_HEADLESS=true
# Ưu tiên REFRESH_INTERVAL (giây) nếu được set; nếu không dùng SCRAPER_REFRESH_MINUTES (phút)
SCRAPER_REFRESH_MINUTES=2
REFRESH_INTERVAL=100
# Tự dọn cache từ phiên deploy cũ khi khởi động (giữ lại telegram state)
CLEANUP_ON_STARTUP=true

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ===== PaaS =====
# PORT dùng cho health-check server (GET / trả 200 OK). Bỏ trống để tắt.
PORT=5000
# Bật/tắt health server (mặc định true)
HEALTH_SERVER_ENABLED=true

